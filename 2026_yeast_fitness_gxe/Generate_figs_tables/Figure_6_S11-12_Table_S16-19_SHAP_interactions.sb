#!/bin/bash --login
#SBATCH --time=4:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=2
# SBATCH --cpus-per-task=15 # for RF models
# SBATCH --mem-per-cpu=3G # for RF models
# SBATCH --job-name ben_rf_individual
# SBATCH --job-name ben_rf_integrated
# SBATCH --cpus-per-task=4 # for shap interaction
# SBATCH --mem-per-cpu=100G # for shap interaction
#SBATCH --cpus-per-task=8 # for orf fig4a rf shap interaction
#SBATCH --mem-per-cpu=100G # for orf fig4a rf shap interaction (100G for snp)
#SBATCH --job-name shap_interaction
# SBATCH --output=/mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_rf/logs/%x_%j.out
# SBATCH --output=/mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_opt_rf/logs/%x_%j.out
#SBATCH --output=/mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_fig4a_rf/logs/%x_%j.out

shap=/mnt/research/glbrc_group/shiulab/kenia/Shiu_Lab/Project/Scripts/Data_Vis
data=/mnt/research/glbrc_group/shiulab/kenia/Shiu_Lab/Project/Data/Peter_2018
pipe=/mnt/research/glbrc_group/shiulab/kenia/Shiu_Lab/Project/External_software/ML-Pipeline

############ SHAP Interaction Scores of Figure 4A Benomyl RF Models ############
# see reviewer_1_responses.py for how the feature tables were made
module purge
conda activate shap

cd /mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_fig4a_rf

## Calculate SHAP interaction scores of the single variant type models
# SNP model
cd snp
python ${shap}/SHAP_training_saving_interaction.py \
	-df ../snp_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-model ../../RF/bench_gene_models/snp_YPDBENOMYL500_bench_plus_important_non_bench_genes_best_model.pkl \
	-top 20 -interaction n -interaction_score y \
	-save snp_fig4a_benomyl_500ugml

echo "Summing SHAP values across isolates for SNP"
python ${shap}/Sum_SHAP_interaction.py \
	-path /mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_fig4a_rf/snp/ \
	-dtype snp \
	-save total_shap_interaction_scores_snp_fig4a_benomyl_500ugml # summed scores on the off diagonals, according to Lundberg et al., 2020 Nature Machine Intelligence

# PAV model
cd pav
python ${shap}/SHAP_training_saving_interaction.py \
	-df ../pav_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-model ../../RF/bench_gene_models/pav_YPDBENOMYL500_important_non_bench_genes_plus_bench_genes_best_model.pkl \
	-top 20 -interaction n -interaction_score y \
	-save pav_fig4a_benomyl_500ugml

echo "Summing SHAP values across isolates for PAV"
python ${shap}/Sum_SHAP_interaction.py \
	-path /mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_fig4a_rf/pav/ \
	-dtype pav \
	-save total_shap_interaction_scores_pav_fig4a_benomyl_500ugml # summed scores on the off diagonals, according to Lundberg et al., 2020 Nature Machine Intelligence

# CNV model
cd ../cnv
python ${shap}/SHAP_training_saving_interaction.py \
	-df ../cnv_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-model ../../RF/bench_gene_models/cnv_YPDBENOMYL500_important_non_bench_genes_plus_bench_genes_best_model.pkl \
	-top 20 -interaction n -interaction_score y \
	-save cnv_fig4a_benomyl_500ugml

echo "Summing SHAP values across isolates for CNV"
python ${shap}/Sum_SHAP_interaction.py \
	-path /mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_fig4a_rf/cnv/ \
	-dtype cnv \
	-save total_shap_interaction_scores_cnv_fig4a_benomyl_500ugml # summed scores on the off diagonals, according to Lundberg et al., 2020 Nature Machine Intelligence

conda activate ml-pipeline
pipe=/mnt/research/glbrc_group/shiulab/kenia/Shiu_Lab/ML-Pipeline

# Submit the integrated models
cd snp_pav
python ${pipe}/ML_regression.py \
	-df ../integrated_snp_pav_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-alg RF -n_jobs 12 -n 20 -cv_num 5 -plots f \
	-tag integrated_snp_pav_fig4a_benomyl_500ugml \
	-save integrated_snp_pav_fig4a_benomyl_500ugml

cd snp_cnv
python ${pipe}/ML_regression.py \
	-df ../integrated_snp_cnv_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-alg RF -n_jobs 12 -n 20 -cv_num 5 -plots f \
	-tag integrated_snp_cnv_fig4a_benomyl_500ugml \
	-save integrated_snp_cnv_fig4a_benomyl_500ugml

cd pav_cnv
python ${pipe}/ML_regression.py \
	-df ../integrated_pav_cnv_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-alg RF -n_jobs 12 -n 20 -cv_num 5 -plots f \
	-tag integrated_pav_cnv_fig4a_benomyl_500ugml \
	-save integrated_pav_cnv_fig4a_benomyl_500ugml

cd snp_pav_cnv
python ${pipe}/ML_regression.py \
	-df ../integrated_snp_pav_cnv_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-alg RF -n_jobs 12 -n 20 -cv_num 5 -plots f \
	-tag integrated_snp_pav_cnv_fig4a_benomyl_500ugml \
	-save integrated_snp_pav_cnv_fig4a_benomyl_500ugml


## Calculate the SHAP interaction values of integrated models
cd snp_pav
python ${shap}/SHAP_training_saving_interaction.py \
	-df ../integrated_snp_pav_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-model integrated_snp_pav_fig4a_benomyl_500ugml_best_model.pkl \
	-top 20 -interaction n -interaction_score y \
	-save integrated_snp_pav_fig4a_benomyl_500ugml

echo "Summing SHAP values across isolates for integrated SNP + PAV model"
python ${shap}/Sum_SHAP_interaction.py \
	-path /mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_fig4a_rf/snp_pav/ \
	-dtype integrated_snp_pav \
	-save total_shap_interaction_scores_integrated_snp_pav_fig4a_benomyl_500ugml

cd snp_cnv
python ${shap}/SHAP_training_saving_interaction.py \
	-df ../integrated_snp_cnv_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-model integrated_snp_cnv_fig4a_benomyl_500ugml_best_model.pkl \
	-top 20 -interaction n -interaction_score y \
	-save integrated_snp_cnv_fig4a_benomyl_500ugml

echo "Summing SHAP values across isolates for integrated SNP + CNV model"
python ${shap}/Sum_SHAP_interaction.py \
	-path /mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_fig4a_rf/snp_cnv/ \
	-dtype integrated_snp_cnv \
	-save total_shap_interaction_scores_integrated_snp_cnv_fig4a_benomyl_500ugml

cd pav_cnv
python ${shap}/SHAP_training_saving_interaction.py \
	-df ../integrated_pav_cnv_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-model integrated_pav_cnv_fig4a_benomyl_500ugml_best_model.pkl \
	-top 20 -interaction n -interaction_score y \
	-save integrated_pav_cnv_fig4a_benomyl_500ugml

echo "Summing SHAP values across isolates for integrated PAV + CNV model"
python ${shap}/Sum_SHAP_interaction.py \
	-path /mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_fig4a_rf/pav_cnv/ \
	-dtype integrated_pav_cnv \
	-save total_shap_interaction_scores_integrated_pav_cnv_fig4a_benomyl_500ugml

cd snp_pav_cnv
python ${shap}/SHAP_training_saving_interaction.py \
	-df ../integrated_snp_pav_cnv_important_non_bench_plus_bench_genes_YPDBENOMYL500.txt \
	-df2 ${data}/pheno.csv -sep , \
	-y_name YPDBENOMYL500 \
	-test ${data}/Test.txt \
	-feat all \
	-model integrated_snp_pav_cnv_fig4a_benomyl_500ugml_best_model.pkl \
	-top 20 -interaction n -interaction_score y \
	-save integrated_snp_pav_cnv_fig4a_benomyl_500ugml

echo "Summing SHAP values across isolates for integrated SNP + PAV + CNV model"
python ${shap}/Sum_SHAP_interaction.py \
	-path /mnt/research/glbrc_group/shiulab/kenia/yeast_project/SHAP_Interaction/benomyl_shap_int_fig4a_rf/snp_pav_cnv/ \
	-dtype integrated_snp_pav_cnv \
	-save total_shap_interaction_scores_integrated_snp_pav_cnv_fig4a_benomyl_500ugml

conda deactivate

